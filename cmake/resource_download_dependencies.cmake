include(FetchContent)
# Scoped normal variables preserve the enclosing project's options. Dependency
# sources are separately pinned/retained; no executable/doc/test is built.
function(mc_add_resource_download_dependencies)
    # Preserve function-scoped dependency selections when child projects create
    # cache entries. curl's tri-state options otherwise replace normal values.
    set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)
    set(CMAKE_POLICY_DEFAULT_CMP0126 NEW)
    set(BUILD_SHARED_LIBS OFF)
    set(BUILD_STATIC_LIBS ON)
    set(BUILD_CURL_EXE OFF)
    set(BUILD_TESTING OFF)
    set(BUILD_LIBCURL_DOCS OFF)
    set(ENABLE_CURL_MANUAL OFF)
    set(CURL_DISABLE_INSTALL ON)
    set(CURL_ENABLE_EXPORT_TARGET OFF)
    set(CURL_ENABLE_SSL OFF)
    set(CURL_USE_LIBPSL OFF)
    set(CURL_USE_LIBSSH OFF)
    set(CURL_USE_LIBSSH2 OFF)
    set(CURL_USE_GSSAPI OFF)
    set(CURL_ZLIB OFF)
    set(CURL_BROTLI OFF)
    set(CURL_ZSTD OFF)
    set(USE_NGHTTP2 OFF)
    set(USE_NGHTTP3 OFF)
    set(USE_LIBIDN2 OFF)
    set(ENABLE_ARES OFF)
    set(ENABLE_THREADED_RESOLVER ON)
    foreach(protocol DICT FILE FTP GOPHER IMAP LDAP LDAPS MQTT POP3 RTSP SMB SMTP TELNET TFTP WEBSOCKETS)
        set(CURL_DISABLE_${protocol} ON)
    endforeach()
    set(EXPAT_SHARED_LIBS OFF)
    set(EXPAT_BUILD_TOOLS OFF)
    set(EXPAT_BUILD_EXAMPLES OFF)
    set(EXPAT_BUILD_TESTS OFF)
    set(EXPAT_BUILD_DOCS OFF)
    set(EXPAT_BUILD_FUZZERS OFF)
    set(EXPAT_BUILD_PKGCONFIG OFF)
    set(EXPAT_ENABLE_INSTALL OFF)
    set(EXPAT_CHAR_TYPE char)
    FetchContent_Declare(mc_resource_curl
        URL https://curl.se/download/curl-8.23.0.tar.xz
        URL_HASH SHA256=8dadd7d2536a314f982ad05a651b713f426bf7d02cc2c76cffb9796f2218e6c5)
    FetchContent_Declare(mc_resource_expat
        URL https://github.com/libexpat/libexpat/releases/download/R_2_9_0/expat-2.9.0.tar.xz
        URL_HASH SHA256=1e6371862cc31999b368c3b89b49994f0677e1bab5f1b2b85ae3741f5d803051)
    FetchContent_MakeAvailable(mc_resource_curl mc_resource_expat)
endfunction()
